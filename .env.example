######################################################################
# Quiet Hours Pipeline — environment configuration
# Copy this file to ".env" and fill in your own values. NEVER commit .env.
######################################################################

# --- Anthropic (ideas + script) -------------------------------------
# https://console.anthropic.com  -> API keys
ANTHROPIC_API_KEY=

# --- MusicGPT (audio: instrumental bed + optional text-to-speech) ---
# https://musicgpt.com  -> dashboard / API. Sent as the raw Authorization header.
MUSICGPT_API_KEY=
# Optional: a public HTTPS URL to receive MusicGPT webhooks. If blank, the
# pipeline polls the status endpoint instead (recommended for local runs).
MUSICGPT_WEBHOOK_URL=
# Advanced: conversionType used when polling text-to-speech results
# (only needed for MODE_FULL_AUTO; override if your account differs).
# MUSICGPT_TTS_CONVERSION_TYPE=TEXT_TO_SPEECH

# --- Visuals backend: "segmind" (default, headless REST) or "higgsfield" ---
VISUALS_BACKEND=segmind

# Segmind hosted Higgsfield endpoints (used when VISUALS_BACKEND=segmind).
# https://www.segmind.com  -> API keys
SEGMIND_API_KEY=
# Required IDs — pick from Segmind's Higgsfield model explorer:
#   image2video motion preset UUID, and text2image-soul style id.
HIGGSFIELD_MOTION_ID=
HIGGSFIELD_STYLE_ID=
# Optional tuning:
HIGGSFIELD_MODEL=dop-preview          # dop-lite | dop-preview | dop-turbo
HIGGSFIELD_MOTION_STRENGTH=0.6        # 0..1
HIGGSFIELD_THUMB_SIZE=2048x1152       # a 16:9 size from Segmind's supported list
# HIGGSFIELD_IMAGE_URL=               # optional starting image (public URL)

# Official Higgsfield (used when VISUALS_BACKEND=higgsfield). OAuth/credit-based
# via `npx skills add higgsfield-ai/skills`; key kept here for reference.
HIGGSFIELD_API_KEY=

# --- YouTube Data API v3 --------------------------------------------
# Path to the OAuth client-secret JSON downloaded from Google Cloud Console.
YOUTUBE_CLIENT_SECRET=client_secret.json
# Video category id (22 = People & Blogs; 24 = Entertainment; 10 = Music).
YOUTUBE_CATEGORY_ID=22

# --- Telegram notifications + remote approval -----------------------
# Create a bot with @BotFather to get the token; then message your bot and read
# the chat id from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Pipeline behaviour ---------------------------------------------
# MODE_OWN_VOICE: mix an instrumental bed under input/voiceover.mp3 (your voice)
# MODE_FULL_AUTO: MusicGPT text-to-speech narration + instrumental bed
AUDIO_MODE=MODE_OWN_VOICE
# Final video / audio length in seconds (default 30 minutes).
TARGET_LENGTH_SECONDS=1800
# How long to wait for a Telegram approval tap before falling back to the CLI.
APPROVAL_TIMEOUT_SECONDS=900

        "jsonBody": "={{ { \"chat_id\": $('Config').item.json.chatId, \"text\": \"💡 Pick a video idea:\\n\\n\" + ($json.ideas||[]).map((x,i)=>(i+1)+\". \"+x.title+\" — \"+x.concept).join(\"\\n\"), \"reply_markup\": { \"inline_keyboard\": [ ($json.ideas||[]).map((x,i)=>({ \"text\": String(i+1), \"url\": $execution.resumeUrl + \"?pick=\" + (i+1) })) ] } } }}",

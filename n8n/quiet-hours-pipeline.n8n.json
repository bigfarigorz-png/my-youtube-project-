    {
      "parameters": {
        "jsCode": "const j = $json || {};\nconst src = j.query || j.body || j.params || j;\nconst list = $('Get Ideas').first().json.ideas || [];\nlet n = parseInt(src.pick, 10);\nif (!n || n < 1 || n > list.length) n = 1;\nreturn [{ json: { pick: n, idea: list[n - 1] } }];"
      },

    {
      "parameters": {
        "jsCode": "const list = $('Get Ideas').first().json.ideas || [];\nconst raw = ($json.data && $json.data.text) ? String($json.data.text) : '1';\nlet n = parseInt(raw.replace(/[^0-9]/g, ''), 10);\nif (!n || n < 1 || n > list.length) n = 1;\nreturn [{ json: { pick: n, idea: list[n - 1] } }];"
      },
